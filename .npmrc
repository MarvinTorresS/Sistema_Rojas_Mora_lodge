# ============================================================
# Configuracion de seguridad para pnpm
# ============================================================
# No ejecutar automaticamente los scripts (postinstall, preinstall,
# etc.) de las dependencias al instalarlas. Este es el mecanismo que
# usan los ataques a la cadena de suministro de npm (ej. Shai-Hulud)
# para ejecutar codigo malicioso apenas se instala un paquete.
#
# pnpm ya bloquea esto por defecto desde hace varias versiones; lo
# dejamos explicito aqui para que quede documentado y no dependa de
# la configuracion global de cada maquina del equipo.
ignore-scripts=true

# Evita instalar automaticamente versiones "compatibles" mas nuevas
# que las que cada quien probo. Todos instalamos exactamente lo que
# dice el lockfile.
prefer-frozen-lockfile=true
