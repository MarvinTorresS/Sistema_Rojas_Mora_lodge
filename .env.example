# ============================================================
# Variables de entorno — copiar este archivo a backend/.env
# y llenar con los valores reales. NUNCA subir el .env real a Git.
# ============================================================

# --- Base de datos (coincide con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rojas_mora_lodge
DB_USER=root
DB_PASSWORD=root1234

# --- Servidor backend ---
PORT=4000
NODE_ENV=development

# --- Autenticación ---
# Generar uno propio por ambiente, nunca reutilizar este valor de ejemplo.
JWT_SECRET=cambiar-por-un-valor-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Frontend (backend/.env no la usa, es referencia para frontend/.env) ---
VITE_API_URL=http://localhost:4000/api
