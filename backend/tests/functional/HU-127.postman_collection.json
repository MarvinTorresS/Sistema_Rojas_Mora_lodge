            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const e = pm.response.json().error;",
                  "pm.test('Mensaje y código de reserva finalizada', () => {",
