        {
          "name": "CA-3b - Extender X una noche más con la tarifa nueva",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Ejecutar DESPUÉS de CA-1b. X pasa del 05/03 al 06/03/2027.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/{{bookingX}}/extensions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "{{bookingX}}",
                "extensions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newCheckOutDate\": \"2027-03-06\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const a = pm.response.json().data.amounts;",
                  "pm.test('Noche nueva a tarifa vigente; lo registrado no se recalcula', () => {",
                  "  pm.expect(a.nightlyRate).to.eql(90000);",
                  "  pm.expect(a.extensionAmount).to.eql(90000);",
                  "  pm.expect(a.previousTotal).to.eql(320000);",
                  "  pm.expect(a.newTotal).to.eql(410000);",
                  "  pm.expect(a.pendingBalance).to.eql(410000);",
                  "});"
                ]
              }
            }
          ]
        },
