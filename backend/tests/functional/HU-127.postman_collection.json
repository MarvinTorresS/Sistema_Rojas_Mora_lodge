    {
      "name": "CA-1 - Extensión exitosa",
      "item": [
        {
          "name": "CA-1a - Cotización de la extensión (solo lectura)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Muestra cuánto costaría y si hay cupo, sin modificar nada.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/{{bookingX}}/extension-quote?newCheckOutDate=2027-03-05",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "{{bookingX}}",
                "extension-quote"
              ],
              "query": [
                {
                  "key": "newCheckOutDate",
                  "value": "2027-03-05"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().data.amounts;",
                  "pm.test('2 noches adicionales a ₡80 000', () => {",
                  "  pm.expect(pm.response.json().data.stay.extraNights).to.eql(2);",
                  "  pm.expect(a.extensionAmount).to.eql(160000);",
                  "  pm.expect(a.newTotal).to.eql(320000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CA-1b - Confirmar la extensión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Extiende la reserva X del 03/03 al 05/03/2027.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/{{bookingX}}/extensions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "{{bookingX}}",
                "extensions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newCheckOutDate\": \"2027-03-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('Nueva fecha de salida y monto recalculado', () => {",
                  "  pm.expect(d.stay.previousCheckOutDate).to.eql('2027-03-03');",
                  "  pm.expect(d.stay.newCheckOutDate).to.eql('2027-03-05');",
                  "  pm.expect(d.amounts.previousTotal).to.eql(160000);",
                  "  pm.expect(d.amounts.extensionAmount).to.eql(160000);",
                  "  pm.expect(d.amounts.newTotal).to.eql(320000);",
                  "  pm.expect(d.amounts.pendingBalance).to.eql(320000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA-2 - Sin disponibilidad",
      "item": [
        {
          "name": "CA-2a - Extender Y sobre las noches ocupadas por Z",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Y termina el 03/03 y Z ocupa la misma cabina del 03 al 05/03.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/{{bookingY}}/extensions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "{{bookingY}}",
                "extensions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newCheckOutDate\": \"2027-03-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const e = pm.response.json().error;",
                  "pm.test('Mensaje y código de no disponibilidad', () => {",
                  "  pm.expect(e.message).to.eql('No es posible extender la estadía porque la cabina no se encuentra disponible para la fecha solicitada');",
                  "  pm.expect(e.code).to.eql('EXTENSION_NOT_AVAILABLE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CA-2b - Verificar que la reserva Y no cambió",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Confirma que el intento fallido no modificó la reserva.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/extendable?search=401230004",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "extendable"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "401230004"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const item = pm.response.json().data[0];",
                  "pm.test('La salida de Y sigue siendo 2027-03-03', () => pm.expect(item.stay.checkOutDate).to.eql('2027-03-03'));"
                ]
              }
            }
          ]
        }
      ]
    },
