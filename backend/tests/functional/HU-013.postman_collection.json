              "key": "resourceId",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "CA-1 - Registro exitoso",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('Reserva activa con el plan elegido', () => {",
              "  pm.expect(d.booking.status).to.eql('active');",
              "  pm.expect(d.plan.planId).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
