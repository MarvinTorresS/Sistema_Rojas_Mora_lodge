    {
      "name": "CA-3 - Reservas existentes sin cambios",
      "item": [
        {
          "name": "CA-3a - Cotizar extensión de la reserva R (anterior a la nueva tarifa)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "R fue registrada a ₡55 000; su total registrado (₡110 000) debe seguir igual.",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings/{{bookingR}}/extension-quote?newCheckOutDate=2027-04-04",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings",
                "{{bookingR}}",
                "extension-quote"
              ],
              "query": [
                {
                  "key": "newCheckOutDate",
                  "value": "2027-04-04"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().data.amounts;",
                  "pm.test('Lo ya registrado no cambia; lo nuevo usa la tarifa vigente', () => {",
                  "  pm.expect(a.previousTotal).to.eql(110000);",
                  "  pm.expect(a.nightlyRate).to.eql(60000);",
                  "  pm.expect(a.extensionAmount).to.eql(60000);",
                  "  pm.expect(a.newTotal).to.eql(170000);",
                  "});"
                ]
              }
            }
          ]
        },
