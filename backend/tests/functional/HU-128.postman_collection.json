          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const e = pm.response.json().error;",
                  "pm.test('Mensaje de tarifa inválida', () => {",
                  "  pm.expect(e.message).to.eql('La tarifa debe ser un monto mayor a cero');",
                  "  pm.expect(e.details[0].field).to.eql('pricePerNight');",
