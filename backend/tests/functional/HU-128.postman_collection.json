{
  "info": {
    "name": "HU-128 - Editar tarifa por noche de cabina (prueba funcional)",
    "description": "Prueba funcional de HU-128 (Rojas Mora Sports & Lodge). Requiere el backend y la base de datos migrada y sembrada (incluido el seeder de cabinas). Se trabaja siempre sobre la Cabina 2 (resourceId 4, tarifa de arranque ₡55 000). Orden: Preparación, CA-1, CA-2, CA-3 y Restaurar. CA-4 (cancelar) no se prueba aquí: es solo de pantalla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preparación",
      "item": [
        {
          "name": "Preparación - Listar cabinas con su tarifa",
          "request": {
            "method": "GET",
            "header": [],
            "description": "No es evidencia de ningún CA: muestra las tarifas de arranque.",
            "url": {
              "raw": "{{baseUrl}}/api/cabins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabins"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Preparación - Reserva R con la tarifa anterior (Cabina 2 a ₡55 000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "No es evidencia de ningún CA: reserva de 2 noches registrada con la tarifa anterior (total ₡110 000).",
            "url": {
              "raw": "{{baseUrl}}/api/cabin-bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabin-bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 4,\n  \"guestName\": \"Roberto Salas Umaña\",\n  \"guestIdentification\": \"801230008\",\n  \"guestPhone\": \"81112222\",\n  \"guestEmail\": \"roberto.salas@example.com\",\n  \"checkInDate\": \"2027-04-01\",\n  \"checkOutDate\": \"2027-04-03\",\n  \"companions\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bookingR', pm.response.json().data.booking.bookingId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CA-1 - Edición exitosa",
      "item": [
        {
          "name": "CA-1a - Editar la tarifa de la Cabina 2 a ₡60 000",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Cabina 2 pasa de ₡55 000 a ₡60 000.",
            "url": {
              "raw": "{{baseUrl}}/api/cabins/4/rate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabins",
                "4",
                "rate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerNight\": 60000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Tarifa actualizada y anterior informada', () => {",
                  "  pm.expect(d.changed).to.eql(true);",
                  "  pm.expect(d.cabin.pricePerNight).to.eql(60000);",
                  "  pm.expect(d.previousPricePerNight).to.eql(55000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CA-1b - Verificar la tarifa en el listado",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/cabins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cabins"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const cabin = pm.response.json().data.find((c) => c.resourceId === 4);",
                  "pm.test('El listado muestra la tarifa nueva', () => pm.expect(cabin.pricePerNight).to.eql(60000));"
                ]
              }
            }
          ]
        }
      ]
    },
